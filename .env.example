# AnyBeats AI API 配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek API Key (用于 deepseek-chat 模型)
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (用于 gpt-5-nano 模型)
VITE_GPT_API_KEY=your_openai_api_key_here

# 韵脚后端API地址 (默认: http://localhost:8000)
VITE_RHYME_API_URL=http://localhost:8000
